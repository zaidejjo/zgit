<component type="desktop-application">
  <id>com.zaidejjo.zgit</id>
  <metadata_license>Apache-2.0</metadata_license>
  <project_license>Apache-2.0</project_license>
  <name>Zgit</name>
  <summary>A modern, fast Git &amp; GitHub client</summary>
  <description>
    <p>
      Zgit combines local Git operations with GitHub CLI/API features
      (PRs, Issues, Actions, Reviews) into a clean, non-cluttered interface.
      It ships as both a terminal UI (TUI) and a desktop application.
    </p>
    <ul>
      <li>Full Git integration — status, log, branches, tags, remotes</li>
      <li>Commit management with conventional commit tags</li>
      <li>Interactive rebase, cherry-pick, and 3-way merge editor</li>
      <li>GitHub PR, Issue, and Actions management</li>
      <li>AI-powered commit message generation and chat assistant</li>
      <li>Dual UI: terminal (Bubble Tea) and desktop (Wails + React)</li>
    </ul>
  </description>
  <launchable type="desktop-id">com.zaidejjo.zgit.desktop</launchable>
  <url type="homepage">https://github.com/zaidejjo/zgit</url>
  <url type="bugtracker">https://github.com/zaidejjo/zgit/issues</url>
