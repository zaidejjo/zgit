---
---

<section class="py-24">
  <div class="container-main">
    <div class="max-w-4xl mx-auto relative">
      <div class="absolute -inset-x-4 -inset-y-8 bg-gradient-to-r from-primary/5 via-accent/8 to-primary/5 rounded-3xl blur-3xl pointer-events-none" />

      <div class="relative text-center p-8 md:p-12 rounded-2xl border border-white/10 bg-white/[0.03] backdrop-blur-xl">
        <h2 class="text-3xl md:text-4xl font-bold tracking-tight">
          Ready to <span class="gradient-text">ship faster</span>?
        </h2>
        <p class="mt-4 text-lg text-foreground-secondary max-w-lg mx-auto">
          Stop context-switching. Start shipping. Zgit is free and open source.
        </p>
        <div class="mt-8 flex flex-col sm:flex-row items-center justify-center gap-4">
          <a
            href="/install"
            class="inline-flex items-center gap-2 px-6 py-3 rounded-xl bg-primary text-background font-semibold text-sm hover:bg-primary-hover transition-all duration-200 glow-sm"
          >
            <svg class="w-4 h-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
              <path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4"/>
              <polyline points="7 10 12 15 17 10"/>
              <line x1="12" y1="15" x2="12" y2="3"/>
            </svg>
            Install Now
          </a>
          <a
            href="https://github.com/zaidejjo/zgit"
            target="_blank"
            rel="noopener noreferrer"
            class="inline-flex items-center gap-2 px-6 py-3 rounded-xl border border-white/10 bg-white/[0.04] backdrop-blur-sm text-foreground font-medium text-sm hover:border-white/20 transition-all duration-200"
          >
            <svg class="w-4 h-4" viewBox="0 0 24 24" fill="currentColor">
              <path d="M12 0C5.374 0 0 5.373 0 12c0 5.302 3.438 9.8 8.207 11.387.599.111.793-.261.793-.577v-2.234c-3.338.726-4.033-1.416-4.033-1.416-.546-1.387-1.333-1.756-1.333-1.756-1.089-.745.083-.729.083-.729 1.205.084 1.839 1.237 1.839 1.237 1.07 1.834 2.807 1.304 3.492.997.107-.775.418-1.305.762-1.604-2.665-.305-5.467-1.334-5.467-5.931 0-1.311.469-2.381 1.236-3.221-.124-.303-.535-1.524.117-3.176 0 0 1.008-.322 3.301 1.23A11.509 11.509 0 0 1 12 5.803c1.02.005 2.047.138 3.006.404 2.291-1.552 3.297-1.23 3.297-1.23.653 1.653.242 2.874.118 3.176.77.84 1.235 1.911 1.235 3.221 0 4.609-2.807 5.624-5.479 5.921.43.372.823 1.102.823 2.222v3.293c0 .319.192.694.801.576C20.566 21.797 24 17.3 24 12c0-6.627-5.373-12-12-12Z"/>
            </svg>
            Star on GitHub
          </a>
        </div>
      </div>
    </div>
  </div>
</section>
