const features = [
  {
    title: 'AI-Powered Commits',
    description: 'Generate meaningful commit messages from your staged changes. Supports OpenAI, Claude, Groq, and local models via Ollama.',
    icon: 'sparkles',
    gradient: 'from-blue-400 to-indigo-500',
    size: 'md',
  },
  {
    title: 'Smart PR Generation',
    description: 'Create PRs with auto-generated metadata from three-dot diffs (base...head). Senior Dev prompt produces production-quality descriptions.',
    icon: 'git-pull-request',
    gradient: 'from-indigo-400 to-purple-500',
    size: 'md',
  },
  {
    title: 'Desktop App',
    description: 'Beautiful React + TypeScript desktop app with glass UI, dark mode, and real-time Git status. Built with Wails v2.',
    icon: 'monitor',
    gradient: 'from-violet-400 to-blue-500',
    size: 'lg',
  },
  {
    title: 'Terminal TUI',
    description: 'Full-featured terminal UI with Bubble Tea. Commit, branch, diff, and push without leaving your terminal.',
    icon: 'terminal',
    gradient: 'from-cyan-400 to-blue-500',
    size: 'md',
  },
  {
    title: 'GitHub Integration',
    description: 'Browse repos, manage PRs, view workflows, and handle issues — all from within Zgit. Authenticated via OAuth.',
    icon: 'github',
    gradient: 'from-slate-300 to-slate-400',
    size: 'md',
  },
  {
    title: 'Cryptographically Secure',
    description: 'AES-256-GCM encrypted API keys stored locally. No plaintext secrets sent to the frontend. Zero-knowledge by design.',
    icon: 'shield',
    gradient: 'from-rose-400 to-red-500',
    size: 'md',
  },
  {
    title: 'Themable Interface',
    description: 'Custom themes with glass morphism, accent colors, and per-component CSS variables. Dark mode by default, your style always.',
    icon: 'palette',
    gradient: 'from-pink-400 to-rose-500',
    size: 'md',
  },
  {
    title: 'CLI-First Approach',
    description: 'Full Cobra CLI for power users. Scriptable, composable, and designed to fit into your existing Git workflow.',
    icon: 'command',
    gradient: 'from-sky-400 to-cyan-500',
    size: 'md',
  },
];

