---

<section id="features" class="py-24 md:py-32">
  <div class="container-main">
    <div class="max-w-2xl mx-auto text-center mb-16">
      <h2 class="text-3xl md:text-4xl font-bold tracking-tight">
        Everything a modern Git client
        <span class="gradient-text">should be</span>
      </h2>
      <p class="mt-4 text-foreground-secondary text-lg">
        From AI assistance to cryptographic security — Zgit ships with all the tools you need.
      </p>
    </div>

    <!-- Bento Grid -->
    <div class="grid grid-cols-1 md:grid-cols-3 gap-4 max-w-6xl mx-auto">
      {
        features.map((feature, i) => {
          const isLarge = feature.size === 'lg';
          const colSpan = isLarge ? 'md:col-span-2' : '';
          const rowSpan = isLarge ? 'md:row-span-2' : '';
          return (
            <div
              class={`glass-card glass-card-hover p-6 md:p-8 ${colSpan} ${rowSpan} ${
                isLarge ? 'flex flex-col justify-between' : ''
              }`}
            >
              <div class="flex items-start gap-4">
                <div class={`flex-shrink-0 w-12 h-12 rounded-xl bg-gradient-to-br ${feature.gradient} p-2.5`}>
                  <svg class="w-full h-full text-white" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round">
                    <path d={iconPaths[feature.icon]} />
                  </svg>
                </div>
                <div class="min-w-0">
                  <h3 class="text-lg font-semibold text-foreground">{feature.title}</h3>
                  <p class="mt-2 text-sm text-foreground-secondary leading-relaxed">
                    {feature.description}
                  </p>
                </div>
              </div>
            </div>
          );
        })
      }
    </div>
  </div>
</section>
