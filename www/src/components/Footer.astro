---
const year = new Date().getFullYear();
---

<footer class="border-t border-white/5 bg-background">
  <div class="container-main py-12 md:py-16">
    <div class="grid grid-cols-2 md:grid-cols-4 gap-8">
      <!-- Brand -->
      <div class="col-span-2 md:col-span-1">
        <a href="/" class="flex items-center gap-2.5 mb-4">
          <img src="/logo-80.svg" alt="Zgit" class="w-7 h-7" />
          <span class="font-semibold text-foreground">Zgit</span>
        </a>
        <p class="text-sm text-foreground-muted leading-relaxed max-w-xs">
          The Git client developers actually enjoy. AI-powered, cryptographically secure, and beautifully designed.
        </p>
      </div>

      <!-- Product -->
      <div>
        <h4 class="text-sm font-semibold text-foreground mb-4">Product</h4>
        <ul class="space-y-2.5">
          <li><a href="/install" class="text-sm text-foreground-muted hover:text-foreground transition-colors">Install</a></li>
          <li><a href="/docs" class="text-sm text-foreground-muted hover:text-foreground transition-colors">Docs</a></li>
          <li><a href="/docs/getting-started" class="text-sm text-foreground-muted hover:text-foreground transition-colors">Quick Start</a></li>
          <li><a href="/docs/configuration" class="text-sm text-foreground-muted hover:text-foreground transition-colors">Configuration</a></li>
        </ul>
      </div>

      <!-- Community -->
      <div>
        <h4 class="text-sm font-semibold text-foreground mb-4">Community</h4>
        <ul class="space-y-2.5">
          <li>
            <a href="https://github.com/zaidejjo/zgit" target="_blank" rel="noopener noreferrer" class="text-sm text-foreground-muted hover:text-foreground transition-colors">
              GitHub
            </a>
          </li>
          <li>
            <a href="https://github.com/zaidejjo/zgit/issues" target="_blank" rel="noopener noreferrer" class="text-sm text-foreground-muted hover:text-foreground transition-colors">
              Issues
            </a>
          </li>
          <li>
            <a href="https://github.com/zaidejjo/zgit/discussions" target="_blank" rel="noopener noreferrer" class="text-sm text-foreground-muted hover:text-foreground transition-colors">
              Discussions
            </a>
          </li>
        </ul>
      </div>

      <!-- More -->
      <div>
        <h4 class="text-sm font-semibold text-foreground mb-4">More</h4>
        <ul class="space-y-2.5">
          <li><a href="/docs/troubleshooting" class="text-sm text-foreground-muted hover:text-foreground transition-colors">Troubleshooting</a></li>
          <li><a href="/docs/keybindings" class="text-sm text-foreground-muted hover:text-foreground transition-colors">Keybindings</a></li>
        </ul>
      </div>
    </div>

    <div class="mt-12 pt-8 border-t border-white/5 flex flex-col md:flex-row items-center justify-between gap-4">
      <p class="text-sm text-foreground-muted">
        &copy; {year} Zgit. Open source under the MIT License.
      </p>
      <div class="flex items-center gap-4">
        <a href="https://github.com/zaidejjo/zgit" target="_blank" rel="noopener noreferrer" class="text-foreground-muted hover:text-foreground transition-colors">
          <svg class="w-5 h-5" viewBox="0 0 24 24" fill="currentColor">
            <path d="M12 0C5.374 0 0 5.373 0 12c0 5.302 3.438 9.8 8.207 11.387.599.111.793-.261.793-.577v-2.234c-3.338.726-4.033-1.416-4.033-1.416-.546-1.387-1.333-1.756-1.333-1.756-1.089-.745.083-.729.083-.729 1.205.084 1.839 1.237 1.839 1.237 1.07 1.834 2.807 1.304 3.492.997.107-.775.418-1.305.762-1.604-2.665-.305-5.467-1.334-5.467-5.931 0-1.311.469-2.381 1.236-3.221-.124-.303-.535-1.524.117-3.176 0 0 1.008-.322 3.301 1.23A11.509 11.509 0 0 1 12 5.803c1.02.005 2.047.138 3.006.404 2.291-1.552 3.297-1.23 3.297-1.23.653 1.653.242 2.874.118 3.176.77.84 1.235 1.911 1.235 3.221 0 4.609-2.807 5.624-5.479 5.921.43.372.823 1.102.823 2.222v3.293c0 .319.192.694.801.576C20.566 21.797 24 17.3 24 12c0-6.627-5.373-12-12-12Z"/>
          </svg>
        </a>
      </div>
    </div>
  </div>
</footer>
