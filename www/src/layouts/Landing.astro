---
import '../styles/global.css';

export interface Props {
  title?: string;
  description?: string;
}

const { title = 'Zgit — The Git Client You\'ll Actually Enjoy', description = 'Modern Git client with AI-powered commits, smart PR generation, and a beautiful desktop & TUI experience.' } = Astro.props;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <link rel="icon" type="image/svg+xml" href="/favicon.ico" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="generator" content={Astro.generator} />
    <meta name="description" content={description} />

    <!-- Open Graph -->
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="website" />
    <meta property="og:url" content="https://zgit.pages.dev" />
    <meta property="og:image" content="https://zgit.pages.dev/images/og-image.png" />

    <!-- Twitter Card -->
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />

    <title>{title}</title>

    <!-- Preload critical font -->
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link rel="preload" as="style" href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800&display=swap" />

    <slot name="head" />
  </head>
  <body class="bg-background text-foreground min-h-screen">
    <slot />
  </body>
</html>
